{
  "name": "@open-harness/oh-workspace-references",
  "description": "Session reference projects (ctx.workspaceReferences): up to N additional read-only project directories attached to one session for comparison, logged as whole-value workspace/references events and surfaced to the model as a stable prompt section",
  "version": "0.1.0-rc.7",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/workspace/workspace-references"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./client": {
      "types": "./lib/types/client.d.ts",
      "default": "./lib/types/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@open-harness/oh-agent": "workspace:^",
    "@open-harness/oh-invariants": "workspace:^",
    "@open-harness/oh-session": "workspace:^",
    "@open-harness/oh-session-projection": "workspace:^",
    "@open-harness/oh-system-prompt": "workspace:^",
    "@deepseek-ai/cordis": "workspace:^"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "workspace:^",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@open-harness/oh-agent": "workspace:^",
    "@open-harness/oh-invariants": "workspace:^",
    "@open-harness/oh-session": "workspace:^",
    "@open-harness/oh-session-projection": "workspace:^",
    "@open-harness/oh-system-prompt": "workspace:^",
    "@deepseek-ai/cordis": "workspace:^"
  }
}
