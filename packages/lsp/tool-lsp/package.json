{
  "name": "@open-harness/oh-tool-lsp",
  "description": "Model-facing lsp tool over the Open Harness LSP capability seam (ctx.lsp) — one read-only tool with goToDefinition/findReferences/goToImplementation/hover operations, one-based UTF-16 cursor coordinates, bounded location rendering, and hover normalization",
  "version": "0.1.0-rc.7",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/lsp/tool-lsp"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@open-harness/oh-invariants": "workspace:^",
    "@open-harness/oh-llm": "workspace:^",
    "@open-harness/oh-lsp": "workspace:^",
    "@open-harness/oh-system-prompt": "workspace:^",
    "@open-harness/oh-timeout": "workspace:^",
    "@open-harness/oh-tools": "workspace:^",
    "@open-harness/cordis": "workspace:^"
  },
  "dependencies": {
    "@open-harness/schemastery": "workspace:^"
  },
  "devDependencies": {
    "@open-harness/oh-agent": "workspace:^",
    "@open-harness/oh-fs-local": "workspace:^",
    "@open-harness/oh-invariants": "workspace:^",
    "@open-harness/oh-llm": "workspace:^",
    "@open-harness/oh-lsp": "workspace:^",
    "@open-harness/oh-lsp-stdio": "workspace:^",
    "@open-harness/oh-session": "workspace:^",
    "@open-harness/oh-subprocess-local": "workspace:^",
    "@open-harness/oh-system-prompt": "workspace:^",
    "@open-harness/oh-timeout": "workspace:^",
    "@open-harness/oh-tool-call-timeout-policy": "workspace:^",
    "@open-harness/oh-tools": "workspace:^",
    "@open-harness/cordis": "workspace:^"
  }
}
