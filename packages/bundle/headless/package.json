{
  "name": "@open-harness/oh-headless",
  "description": "The oh one-shot bundle: a direct core Agent/Session runner over oh-base with no Host, HTTP, or browser layer",
  "version": "0.1.0-rc.7",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/bundle/headless"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./startup": {
      "types": "./lib/types/startup.d.ts",
      "default": "./lib/startup.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/startup.js",
    "cordis.patch.yml",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "oh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "@open-harness/oh-cmdline": "workspace:^",
    "@open-harness/oh-code-runtime-worker-thread": "workspace:^",
    "@open-harness/schemastery": "workspace:^",
    "commander": "^15.0.0"
  },
  "peerDependencies": {
    "@open-harness/cordis-plugin-loader": "workspace:^",
    "@open-harness/oh-agent": "workspace:^",
    "@open-harness/oh-agent-default-model": "workspace:^",
    "@open-harness/oh-invariants": "workspace:^",
    "@open-harness/oh-llm": "workspace:^",
    "@open-harness/oh-session": "workspace:^",
    "@open-harness/cordis": "workspace:^"
  },
  "devDependencies": {
    "@open-harness/cordis-plugin-loader": "workspace:^",
    "@open-harness/oh-agent": "workspace:^",
    "@open-harness/oh-agent-default-model": "workspace:^",
    "@open-harness/oh-invariants": "workspace:^",
    "@open-harness/oh-llm": "workspace:^",
    "@open-harness/oh-session": "workspace:^",
    "@open-harness/cordis": "workspace:^"
  }
}
