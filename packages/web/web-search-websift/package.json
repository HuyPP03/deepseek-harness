{
  "name": "@open-harness/oh-web-search-websift",
  "description": "Websift-backed search provider (keyless DuckDuckGo or self-hosted SearXNG, in-process TS library) for the Open Harness web capability seam (ctx.web)",
  "version": "0.1.0-rc.7",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/web/web-search-websift"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@open-harness/oh-invariants": "workspace:^",
    "@open-harness/oh-settings": "workspace:^",
    "@open-harness/oh-web": "workspace:^",
    "@open-harness/cordis": "workspace:^"
  },
  "dependencies": {
    "@open-harness/schemastery": "workspace:^",
    "websift": "^2.0.0"
  },
  "devDependencies": {
    "@open-harness/oh-invariants": "workspace:^",
    "@open-harness/oh-settings": "workspace:^",
    "@open-harness/oh-web": "workspace:^",
    "@open-harness/cordis": "workspace:^"
  }
}
