{
  "name": "@open-harness/oh-connectors-oauth-flow",
  "description": "The connector OAuth flow engine: RFC 9728/8414 discovery, dynamic client registration, PKCE, and the loopback callback server that exchanges the code for a stored token bundle.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "UNLICENSED",
  "dependencies": {
    "@open-harness/schemastery": "workspace:^"
  },
  "peerDependencies": {
    "@open-harness/oh-connectors": "workspace:^",
    "@open-harness/oh-credentials": "workspace:^",
    "@open-harness/oh-invariants": "workspace:^",
    "@open-harness/cordis": "workspace:^"
  },
  "devDependencies": {
    "@open-harness/oh-connectors": "workspace:^",
    "@open-harness/oh-credentials": "workspace:^",
    "@open-harness/oh-credentials-oauth-tokens": "workspace:^",
    "@open-harness/oh-invariants": "workspace:^",
    "@open-harness/cordis": "workspace:^"
  }
}
