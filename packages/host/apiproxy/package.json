{
  "name": "@open-harness/oh-host-apiproxy",
  "description": "API gateway: the ApiProxy contract (api/), the fetch carrier pair (fetch/), and the host-side gateway plugin providing ctx.apiProxy",
  "version": "0.1.0-rc.7",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/host/apiproxy"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./api": {
      "types": "./lib/types/api/index.d.ts",
      "default": "./lib/types/api/index.js"
    },
    "./api/*": {
      "types": "./lib/types/api/*.d.ts",
      "default": "./lib/types/api/*.js"
    },
    "./client": {
      "types": "./lib/types/fetch/client.d.ts",
      "default": "./lib/types/fetch/client.js"
    }
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@open-harness/oh-attachment": "workspace:^",
    "@open-harness/oh-agent": "workspace:^",
    "@open-harness/oh-agent-default-model": "workspace:^",
    "@open-harness/oh-api-remotes": "workspace:^",
    "@open-harness/oh-brand": "workspace:^",
    "@open-harness/oh-commands": "workspace:^",
    "@open-harness/oh-connectors": "workspace:^",
    "@open-harness/oh-credentials": "workspace:^",
    "@open-harness/oh-goal": "workspace:^",
    "@open-harness/oh-home-paths": "workspace:^",
    "@open-harness/oh-host-directory-picker": "workspace:^",
    "@open-harness/oh-llm": "workspace:^",
    "@open-harness/oh-mcp-manager": "workspace:^",
    "@open-harness/oh-mcp-registry": "workspace:^",
    "@open-harness/oh-native-command": "workspace:^",
    "@open-harness/oh-session": "workspace:^",
    "@open-harness/oh-session-persistence": "workspace:^",
    "@open-harness/oh-session-projection": "workspace:^",
    "@open-harness/oh-session-projection-cache": "workspace:^",
    "@open-harness/oh-session-query": "workspace:^",
    "@open-harness/oh-session-title": "workspace:^",
    "@open-harness/oh-settings": "workspace:^",
    "@open-harness/oh-skill": "workspace:^",
    "@open-harness/oh-subagent": "workspace:^",
    "@open-harness/oh-jobs": "workspace:^",
    "@open-harness/oh-tools": "workspace:^",
    "@open-harness/oh-user-approval": "workspace:^",
    "@open-harness/oh-user-questions": "workspace:^",
    "@open-harness/oh-workspace": "workspace:^",
    "@open-harness/oh-workspace-references": "workspace:^",
    "@open-harness/schemastery": "workspace:^",
    "fflate": "^0.8.2",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@open-harness/cordis": "workspace:^",
    "@open-harness/oh-agent-presets": "workspace:^",
    "@open-harness/oh-cordis-host-runner": "workspace:^",
    "@open-harness/oh-invariants": "workspace:^"
  },
  "devDependencies": {
    "@open-harness/cordis": "workspace:^",
    "@open-harness/oh-agent-presets": "workspace:^",
    "@open-harness/oh-cordis-host-runner": "workspace:^",
    "@open-harness/oh-invariants": "workspace:^",
    "@open-harness/oh-storage": "workspace:^",
    "@open-harness/oh-storage-domain": "workspace:^",
    "@open-harness/oh-typert-protocol": "workspace:^",
    "@open-harness/oh-typert-registry": "workspace:^",
    "@modelcontextprotocol/sdk": "^1.12.0"
  }
}
