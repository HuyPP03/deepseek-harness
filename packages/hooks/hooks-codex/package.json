{
  "name": "@open-harness/oh-hooks-codex",
  "description": "Bridge plugin: run a Codex hooks.json hook config on the Open Harness interception seams",
  "version": "0.1.0-rc.7",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/hooks/hooks-codex"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@open-harness/schemastery": "workspace:^"
  },
  "peerDependencies": {
    "@open-harness/oh-agent": "workspace:^",
    "@open-harness/oh-hook-protocol": "workspace:^",
    "@open-harness/oh-invariants": "workspace:^",
    "@open-harness/oh-llm": "workspace:^",
    "@open-harness/oh-session": "workspace:^",
    "@open-harness/oh-session-persistence": "workspace:^",
    "@open-harness/oh-tools": "workspace:^",
    "@open-harness/cordis": "workspace:^"
  },
  "devDependencies": {
    "@open-harness/oh-agent": "workspace:^",
    "@open-harness/oh-agent-loop": "workspace:^",
    "@open-harness/oh-agent-loop-testkit": "workspace:^",
    "@open-harness/oh-shell": "workspace:^",
    "@open-harness/oh-bash-local": "workspace:^",
    "@open-harness/oh-subprocess-local": "workspace:^",
    "@open-harness/oh-hook-protocol": "workspace:^",
    "@open-harness/oh-invariants": "workspace:^",
    "@open-harness/oh-llm": "workspace:^",
    "@open-harness/oh-session": "workspace:^",
    "@open-harness/oh-session-persistence": "workspace:^",
    "@open-harness/oh-session-persistence-jsonl": "workspace:^",
    "@open-harness/oh-tools": "workspace:^",
    "@open-harness/cordis": "workspace:^"
  }
}
